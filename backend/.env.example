DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_SSL=true
# Alternatively omit DATABASE_URL and use DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD.
JWT_SECRET=replace-with-a-long-random-secret
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
SUPABASE_STORAGE_BUCKET=slips
APP_URL=https://YOUR_PROJECT.vercel.app
RESEND_API_KEY=server-only-resend-key
RESET_EMAIL_FROM=VanVan <noreply@YOUR_VERIFIED_DOMAIN>
